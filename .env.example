# Banco de dados PostgreSQL
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# NextAuth - gere um valor com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-seguro"
NEXTAUTH_URL="http://localhost:3000"

# Integração com o CRM (ver INTEGRACAO.md) — só por API, nunca banco compartilhado.
# Para desenvolver sem o CRM real: `npm run crm:mock` e use os valores abaixo.
CRM_API_URL="http://localhost:4000"
CRM_API_TOKEN="dev-token"

# URL pública deste software — usada no link do relatório enviado ao CRM.
APP_BASE_URL="http://localhost:3000"
