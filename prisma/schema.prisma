// Prisma schema for the CRM MVP
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CUSTOMER
  LOST
}

enum QuoteType {
  ESTUDO_CLASSIFICACAO_DIARIA
  PROJETO
  CONSULTORIA
  INSPECAO_INICIAL
  INSPECAO_APURADA
  INSPECAO_DETALHADA
  INSTALACAO_TREINAMENTO
}

enum InspectionAccessMode {
  NIVEL_SOLO
  COM_ESCADAS
}

enum InspectionLevel {
  VISUAL
  APURADA
  DETALHADA
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum QuoteItemCategory {
  MAO_DE_OBRA
  MATERIAL
  DESPESA
  OUTROS
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts                Contact[]
  deals                   Deal[]
  tasks                   Task[]
  quotes                  Quote[]
  travelPolicy            TravelPolicy?
  laborRates              LaborRate[]
  inspectionTimeStandards InspectionTimeStandard[]
}

model Contact {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  notes     String?
  status    LeadStatus @default(NEW)
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  deals  Deal[]
  tasks  Task[]
  quotes Quote[]

  @@index([ownerId])
}

model PipelineStage {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  color     String   @default("#94a3b8")
  createdAt DateTime @default(now())

  deals Deal[]

  @@unique([order])
}

model Deal {
  id        String        @id @default(cuid())
  title     String
  value     Float         @default(0)
  order     Int           @default(0)
  contactId String
  contact   Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stageId   String
  stage     PipelineStage @relation(fields: [stageId], references: [id])
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tasks  Task[]
  quotes Quote[]

  @@index([stageId])
  @@index([ownerId])
  @@index([contactId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  done        Boolean   @default(false)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
  @@index([dealId])
  @@index([contactId])
}

// --- Orçamentos -------------------------------------------------------
// Motor de cálculo validado contra a planilha "Cálculo de Custos e
// Despesas" (2026-09-06). Duas "blocos" de custo, cada um com sua
// própria margem:
//   - Mão de obra: subtotal = Σ(horas × custo-hora do cargo)
//   - Despesas:    subtotal = Σ(quantidade × custo unitário do item)
// Cada bloco vira preço de venda como subtotal / (1 - margem do bloco),
// e o ISS incide sobre os dois blocos já com margem:
//   blocoComImposto = (subtotal / (1 - margem)) * (1 + issPct)
// Total da proposta = mão de obra c/ imposto + despesas c/ imposto.

model Quote {
  id         String      @id @default(cuid())
  number     Int         @default(autoincrement())
  type       QuoteType
  status     QuoteStatus @default(DRAFT)
  title      String
  validUntil DateTime?
  notes      String?

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?   @relation(fields: [dealId], references: [id])
  ownerId   String
  owner     User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  laborMarginPct   Float @default(0.5) // margem sobre mão de obra (editável por orçamento)
  expenseMarginPct Float @default(0.3) // margem sobre despesas (editável por orçamento)
  issPct           Float @default(0.07) // ISS, incide sobre mão de obra E despesas

  // Dias de campo (calculado ou informado) + dias de deslocamento (ida/volta,
  // padrão 1) — usados para multiplicar diárias de hospedagem/alimentação/
  // carro alugado nos itens de despesa.
  fieldDays  Float @default(0)
  travelDays Float @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuoteItem[]

  @@index([contactId])
  @@index([ownerId])
  @@index([dealId])
}

// --- Política de Viagem -------------------------------------------------
// Valores padrão para calcular despesa de deslocamento nos orçamentos.
// Não há regra fixa de carro vs. avião: cada orçamento escolhe livremente
// quais componentes usar (podem ser combinados, ex.: avião + carro alugado
// no destino + combustível + estacionamento), cada um puxando o valor
// padrão daqui, editável por orçamento quando necessário.
//
// Combustível: calculado por km rodado real, não por "tanque cheio" —
// custo = (km rodado ÷ consumo em km/L) × preço do litro.

model TravelPolicy {
  id      String @id @default(cuid())
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  originCity String @default("Criciúma/SC")

  // Diária (padrão único, não varia por cidade)
  dailyHotelRate Float @default(0) // R$/dia
  lunchRate      Float @default(0) // R$/almoço
  dinnerRate     Float @default(0) // R$/janta

  // Dias de deslocamento padrão (ida + volta) somados aos dias de campo
  // para multiplicar as diárias acima. Editável por orçamento.
  defaultTravelDays Float @default(1)

  // Combustível (carro próprio ou alugado), calculado por km rodado
  fuelPricePerLiter            Float @default(0) // R$/litro
  vehicleConsumptionKmPerLiter Float @default(10) // km/L (ex.: 10 km/L)

  // Avião
  flightTicketDefault Float @default(0) // R$, valor de referência (editável por orçamento)

  // Carro alugado no destino (pode ser combinado com avião)
  rentalCarDailyRate Float @default(0) // R$/dia
  parkingDefault     Float @default(0) // R$, valor de referência de estacionamento

  updatedAt DateTime @updatedAt
}

// --- Tabela de Cargos (HH) -----------------------------------------------
// Custo-hora por cargo/atividade, extensível (novos serviços como
// Instalação usam profissionais adicionais). Preço de venda de cada
// hora é calculado no orçamento como custo-hora / (1 - margem mão de obra).

model LaborRate {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  code       String? // código interno opcional (ex.: 102166)
  name       String // ex.: "HH de campo", "HH de escritório", "HH desenhos em CAD"
  hourlyCost Float    @default(0) // R$/hora (custo, sem margem)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
}

// --- Tempo padrão de Inspeção ---------------------------------------------
// Minutos por equipamento, por combinação de modo de acesso × nível de
// inspeção. Alimenta a calculadora de horas de campo dos orçamentos do
// tipo Inspeção: o usuário só informa a quantidade de equipamentos.

model InspectionTimeStandard {
  id              String               @id @default(cuid())
  ownerId         String
  owner           User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  accessMode      InspectionAccessMode
  inspectionLevel InspectionLevel
  minutesPerUnit  Float                @default(0)
  updatedAt       DateTime             @updatedAt

  @@unique([ownerId, accessMode, inspectionLevel])
}

model QuoteItem {
  id          String            @id @default(cuid())
  quoteId     String
  quote       Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  category    QuoteItemCategory
  description String
  quantity    Float             @default(1)
  unitCost    Float             @default(0) // custo unitário (interno)
  unit        String            @default("un")
  order       Int               @default(0)

  @@index([quoteId])
}
